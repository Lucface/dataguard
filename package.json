{
  "name": "dataguard",
  "version": "1.0.0",
  "description": "Schema-agnostic data-quality checks for PostgreSQL (including Neon) and SQLite: referential integrity, date sequences, calculated fields, null analysis, business rules.",
  "main": "index.ts",
  "bin": {
    "data-quality": "./cli.ts"
  },
  "scripts": {
    "validate": "tsx cli.ts",
    "validate:quick": "tsx cli.ts --only referential-integrity",
    "report": "tsx cli.ts --format html --output report.html",
    "check": "tsx cli.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "keywords": [
    "data-quality",
    "validation",
    "database",
    "integrity",
    "testing"
  ],
  "author": "Lucas Cooper-Bey",
  "license": "MIT",
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "drizzle-orm": "^0.44.7"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3",
    "pg": "^8.23.1"
  }
}
