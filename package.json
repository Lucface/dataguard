{
  "name": "dataguard",
  "version": "1.0.0",
  "description": "DataGuard — schema-agnostic data-quality validation for any SQL database (referential integrity, date sequences, calculated fields, null analysis, business rules).",
  "main": "index.ts",
  "bin": {
    "data-quality": "./cli.ts"
  },
  "scripts": {
    "validate": "tsx cli.ts",
    "validate:quick": "tsx cli.ts --only referential-integrity",
    "report": "tsx cli.ts --format html --output report.html",
    "check": "tsx cli.ts"
  },
  "keywords": [
    "data-quality",
    "validation",
    "database",
    "integrity",
    "testing"
  ],
  "author": "Lucas Cooper-Bey",
  "license": "MIT",
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "drizzle-orm": "^0.44.7"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "peerDependencies": {
    "pg": "^8.0.0",
    "mysql2": "^3.0.0",
    "better-sqlite3": "^9.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  }
}
